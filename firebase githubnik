<button id="login">Войти через GitHub</button>
<p id="out"></p>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
  import { getAuth, GithubAuthProvider, signInWithPopup }
    from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyD1MVDy8Qqs3J6xXjlLNlDkNeU1DvTvTsQ",
    authDomain: "tink-6567c.firebaseapp.com",
    databaseURL: "https://tink-6567c-default-rtdb.firebaseio.com",
    projectId: "tink-6567c",
    storageBucket: "tink-6567c.firebasestorage.app",
    messagingSenderId: "936605913462",
    appId: "1:936605913462:web:bf5dd2f96fa5f6e2212a57",
    measurementId: "G-VBBMBPBCC3"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  document.getElementById("login").onclick = async () => {
    try {
      const res = await signInWithPopup(auth, new GithubAuthProvider());
      document.getElementById("out").textContent =
        "Вошли как " + (res.user.displayName || res.user.uid);
    } catch (e) {
      document.getElementById("out").textContent = e.code;
    }
  };
</script>
